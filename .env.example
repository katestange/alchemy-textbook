# Copy to .env and fill in. NEVER commit .env (publish.sh refuses if staged).
# Book identity (title, invite prefix, ...) is NOT here — that's book.toml.

# Required: the instructor's Anthropic API key that funds all AI generation.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Required on first startup: seeds the instructor dashboard password (one-time;
# to change it later, delete the admin table row and restart with a new value).
ADMIN_PASSWORD=choose-a-strong-password

# --- Optional (defaults in parentheses) ------------------------------------

# SQLite database location (backend/textbook.db)
#TEXTBOOK_DB=/data/textbook.db

# Pipeline output directory the backend serves (<repo>/build)
#TEXTBOOK_BUILD_DIR=/workspace/build

# Bind address/port for `python backend/app.py` (127.0.0.1:8000).
# Set TEXTBOOK_HOST=0.0.0.0 inside a container.
#TEXTBOOK_HOST=127.0.0.1
#TEXTBOOK_PORT=8000

# Set to 1 whenever the app is served over HTTPS (any real deployment):
# marks session + admin cookies Secure. (0)
#TEXTBOOK_COOKIE_SECURE=1

# Set to 1 in local dev ONLY: seeds the well-known DEV-TEST-1 invite code
# ($5 budget) on first startup. Never set in production. (0)
#TEXTBOOK_SEED_DEV_CODE=1
