# ============================================================
# SECRETS — never commit these. Committing .env leaks the
# instructor Anthropic API key. If it ever lands in a commit,
# ROTATE the key immediately (a git delete is not enough —
# it stays in history).
# ============================================================
.env
.env.*
# (the template has no secrets — keep it committed)
!.env.example
*.key
*.pem

# ============================================================
# Build artifacts — regenerated by `bash pipeline/build.sh`.
# Source (.tex + images) is tracked; outputs are not.
# ============================================================
build/
*.latexml.log
*.latexmlpost.log

